Count Digits in a Number
#include <stdio.h>

int main() {
    int num, temp, count = 0;
    printf("Enter a number: ");
    scanf("%d", &num);

    temp = num;

    // Handle the case where the input number is 0
    if (temp == 0) {
        count = 1;
    } else {
        while (temp != 0) {
            temp /= 10;
            count++;
        }
    }

    printf("The number of digits in %d is: %d\n", num, count);
    return 0;
